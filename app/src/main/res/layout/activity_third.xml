<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snack_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Judul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_title"
            android:textColor="@color/snack_green"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Subjudul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_subtitle"
            android:textColor="@color/snack_yellow"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Gambar Chitato -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/chitato_lite_rumput_laut"
            android:contentDescription="@string/chitato_image_description"
            android:scaleType="centerInside"
            android:layout_marginBottom="10dp" />

        <!-- Deskripsi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_description"
            android:textColor="@color/snack_text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="14dp" />

        <!-- Informasi Gizi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nutrition_title"
            android:textColor="@color/snack_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Takaran Saji -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serving_size"
            android:textColor="@color/snack_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- Energi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/snack_card">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/energy"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/energy_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Lemak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fat"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fat_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Karbohidrat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/snack_card">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/carbohydrate"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carbohydrate_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Protein -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/protein"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protein_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Gula -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/snack_card">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sugar"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sugar_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Garam -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/salt"
                android:textColor="@color/snack_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salt_value"
                android:textColor="@color/snack_green"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Komposisi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ingredients_title"
            android:textColor="@color/snack_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ingredients"
            android:textColor="@color/snack_text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>