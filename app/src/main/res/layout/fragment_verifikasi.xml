                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_bold"
                                    android:text="Verifikasi Anggota"
                                    android:textColor="@color/putih"
                                    android:textSize="20sp" />
                            </LinearLayout>
