<?xml version="1.0" encoding="utf-8"?>
<!-- [MATERI P7 - FRAGMENT] A1 · Dashboard Admin Anggota (menu Beranda)
     Root diubah FrameLayout -> ConstraintLayout (langkah 4 & 6 modul) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar"
    tools:context=".sikuda.anggota.beranda.BerandaFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Header foto sawit (sudut bawah membulat sesuai Figma) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/hijau_tua"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Sikuda.HeaderBawah"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_foto_sawit"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_sawit_udara" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_overlay_hijau" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="72dp">
                    <!-- [MATERI P7 - FRAGMENT] Toolbar di setiap fragment -->
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:minHeight="0dp"
                        app:contentInsetEnd="0dp"
                        app:contentInsetStart="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:id="@+id/btnProfil"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_logo_bulat"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/desc_logo"
                                    android:src="@drawable/logo_sikuda" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="Admin Anggota · Kamis, 1 Okt 2026"
                                    android:textColor="@color/putih_80"
                                    android:textSize="11sp" />
                                <TextView
                                android:id="@+id/txtSapaan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_bold"
                                    android:text="Halo, Siti Rahma!"
                                    android:textColor="@color/putih"
                                    android:textSize="20sp" />
                            </LinearLayout>
                            <FrameLayout
                                android:id="@+id/btnNotifikasi"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tombol_kaca"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_marginStart="8dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_bell"
                                    app:tint="@color/putih" />
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/btnKeluar"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tombol_kaca"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_marginStart="8dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_logout"
                                    app:tint="@color/putih" />
                            </FrameLayout>
                        </LinearLayout>
                    </androidx.appcompat.widget.Toolbar>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">
                <LinearLayout
                    android:layout_marginTop="-56dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="3dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Total Anggota"
                                android:textColor="@color/teks_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="1.250"
                                android:textColor="@color/hijau_sawit"
                                android:textSize="30sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ikon_hijau">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_users"
                                app:tint="@color/hijau_sawit" />
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_track"
                        android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="88" android:background="@drawable/bg_bar_hijau" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="11" android:background="@drawable/bg_bar_emas" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_bar_merah" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="● Aktif 1.100    ● Pasif 138 · Tidak aktif 12"
                        android:textColor="@color/teks_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kartu"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_ikon_hijau">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_user_plus"
                                app:tint="@color/hijau_sawit" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="45"
                            android:textColor="@color/teks_utama"
                            android:textSize="20sp"
                            android:layout_marginTop="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Anggota baru"
                            android:textColor="@color/teks_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_kartu"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_ikon_oranye">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/oranye_tandan" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="30"
                            android:textColor="@color/oranye_tandan"
                            android:textSize="20sp"
                            android:layout_marginTop="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Menunggu verifikasi"
                            android:textColor="@color/teks_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/menuInputCalon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tombol_oranye"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_user_plus"
                            app:tint="@color/putih" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Input calon"
                            android:textColor="@color/putih"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/menuVerifikasi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_kartu"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check"
                            app:tint="@color/hijau_sawit" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Verifikasi"
                            android:textColor="@color/teks_utama"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/menuCetakLaporan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_kartu"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_file"
                            app:tint="@color/hijau_sawit" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Cetak laporan"
                            android:textColor="@color/teks_utama"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_kartu"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Pertumbuhan"
                            android:textColor="@color/teks_utama"
                            android:textSize="14sp"
                            android:layout_weight="1" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_segmen"
                            android:orientation="horizontal"
                            android:padding="3dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Harian"
                                android:textColor="@color/teks_muted"
                                android:textSize="10sp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Mingguan"
                                android:textColor="@color/teks_muted"
                                android:textSize="10sp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="Bulanan"
                                android:textColor="@color/hijau_sawit"
                                android:textSize="10sp"
                                android:background="@drawable/bg_segmen_aktif"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="16dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="66dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_hijau" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bar_oranye" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Jul"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Sep"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Nov"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Jan"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Mar"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Jun"
                            android:textColor="@color/teks_muted"
                            android:textSize="10sp"
                            android:layout_weight="1"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
