<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/latar" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="200dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="@string/desc_foto_sawit" android:scaleType="centerCrop"
                android:src="@drawable/foto_kebun_sawit" />
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_overlay_hijau" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical"
                android:paddingHorizontal="24dp" android:paddingBottom="28dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="KUD LUBUK KARYA  ·  SIKUDA" android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/putih_80" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Registrasi Berhasil" android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/putih" android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="20dp" app:cardBackgroundColor="@color/putih"
            app:cardCornerRadius="26dp" app:cardElevation="3dp"
            app:strokeColor="@color/garis" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="20dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Akun Berhasil Dibuat" android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/hijau_sawit" android:textSize="23sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="Data registrasi sudah disimpan. Sekarang masuk menggunakan username dan password yang baru."
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/teks_muted" android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanjut" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:text="Kembali ke Login" android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>