<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin internet untuk WebView -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nama_aplikasi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FeraDyahAyuPermatasari">
        <!-- Project lama (Chitato) tetap ada, tapi bukan halaman pertama -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ThirdActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- ===================== SIKUDA ===================== -->
        <!-- [MATERI P6 - SPLASH SCREEN] SplashScreenActivity dijadikan halaman utama (LAUNCHER) -->
        <activity
            android:name=".sikuda.splash.SplashScreenActivity"
            android:exported="true"
            android:label="@string/nama_aplikasi"
            android:theme="@style/Theme.Sikuda">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Guest: Beranda (dibuka dari Splash jika isLogin = false, dan setelah Logout) -->
        <activity
            android:name=".sikuda.guest.beranda.MainActivity"
            android:exported="false"
            android:label="@string/nama_aplikasi"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.guest.tentang.TentangActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.guest.layanan.LayananActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.auth.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda"
            android:windowSoftInputMode="adjustResize" />
        <!-- [MATERI P7 - BOTTOM NAVIGATION] BaseActivity = activity utama Admin Keanggotaan
             (menggantikan DashboardAnggotaActivity) -->
        <activity
            android:name=".sikuda.anggota.BaseActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".sikuda.anggota.pendaftaran.FormPendaftaranActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".sikuda.anggota.verifikasi.DetailVerifikasiActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.keuangan.dashboard.DashboardKeuanganActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.pemilik.dashboard.DashboardPemilikActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <!-- Profil Developer -->
        <activity
            android:name=".sikuda.profil.ProfilDeveloperActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />
        <activity
            android:name=".sikuda.web.WebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />

        <!-- [QUIZ P8] Halaman Input Email Gmail -->
        <activity
            android:name=".sikuda.auth.register.EmailGmailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />

        <!-- [QUIZ P8] Halaman Registrasi Akun -->
        <activity
            android:name=".sikuda.auth.register.RegistrasiActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />

        <!-- [QUIZ P8] Halaman Registrasi Berhasil -->
        <activity
            android:name=".sikuda.auth.register.RegistrasiBerhasilActivity"
            android:exported="false"
            android:theme="@style/Theme.Sikuda" />

    </application>

</manifest>